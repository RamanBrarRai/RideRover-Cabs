# Copy this file to backend/.env and fill in the values. NEVER commit the real .env file.

# ---- Database (matches docker-compose.yml for local development) ----
DATABASE_URL=postgres://cab:cabpass@localhost:5432/cab_dev

# ---- Security: make each of these a long random string (32+ characters) ----
# Create one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=

# ---- Server ----
NODE_ENV=development
PORT=4000
# Comma-separated web addresses allowed to call the API (admin panel). Example: http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# ---- SMS / OTP ----
# "console" prints the code in the server window (development only).
# In production use "msg91" and fill the two MSG91 values.
SMS_PROVIDER=console
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# ---- Demo data (development only; the seed command refuses to run in production) ----
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=

# ---- Added in later modules (not used yet) ----
GOOGLE_MAPS_API_KEY=
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
STORAGE_BUCKET=
