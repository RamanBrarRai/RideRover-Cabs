{
  "name": "cab-mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@expo/vector-icons": "^15.1.1",
    "@react-navigation/bottom-tabs": "^7.20.0",
    "@react-navigation/native": "^7.5.0",
    "@react-navigation/native-stack": "^7.20.0",
    "expo": "~57.0.26",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "^19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.3"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "cross-env": "^10.1.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  },
  "scripts": {
    "customer": "cross-env EXPO_PUBLIC_APP_ROLE=CUSTOMER expo start --clear",
    "driver": "cross-env EXPO_PUBLIC_APP_ROLE=DRIVER expo start --clear --port 8082",
    "web:customer": "cross-env EXPO_PUBLIC_APP_ROLE=CUSTOMER expo start --web --clear",
    "web:driver": "cross-env EXPO_PUBLIC_APP_ROLE=DRIVER expo start --web --clear --port 8082",
    "export:customer": "cross-env EXPO_PUBLIC_APP_ROLE=CUSTOMER expo export --clear --platform web --output-dir dist/customer",
    "export:driver": "cross-env EXPO_PUBLIC_APP_ROLE=DRIVER expo export --clear --platform web --output-dir dist/driver",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "private": true
}